+            f"""
+            UPDATE compound
+            SET state=?, failed_stage=?, failure_message=?,
+                modified_at=CURRENT_TIMESTAMP
+            WHERE id IN ({marks})
+            """,
+            [state, failed_stage, failure_message, *ids],
