+                )
+
+            if "[*]" in decorators:
+                raise RuntimeError(
+                    "Unsupported '[*]' token in LibInvent TL decorators: "
+                    f"{decorators}"
+                )
+
+            f.write(
+                f"{scaffold}\t{decorators}\n"
+            )
