+
+def forbidden(*args,**kwargs):
+    raise AssertionError('Pure similarity initialized workflow I/O')
+
+sqlite3.connect=forbidden
+subprocess.run=forbidden
+subprocess.Popen=forbidden
+generator=create_morgan_generator()
